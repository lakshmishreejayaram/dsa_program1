def linear_search(arr, target):
      for i in range(len(arr)):
          if arr[i] == target:
              return i
      return -1
  
arr = ['rice','bread','eggs']
target = 'eggs'
result = linear_search(arr, target)
  
if result != -1:
    print(f"groceries found at index {result}")
else:
    print("groceries not found")
