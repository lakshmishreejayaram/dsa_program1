def linear_search(arr, target):
      for i in range(len(arr)):
          if arr[i] == target:
              return i
      return -1
  
arr = [2, 5, 8]
target = 5
result = linear_search(arr, target)
  
if result != -1:
    print(f"roll number found at index {result}")
else:
    print("roll number not found")
